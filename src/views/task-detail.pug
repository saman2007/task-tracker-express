extends layouts/main-layout.pug
include mixins/priority-badge.pug

block head-tags
  link(rel="stylesheet", href="/css/task-detail.css")

block content
  .detail-container
    .back-nav
      a.btn-back(href="/tasks")
        svg(width="16", height="16", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
          line(x1="19", y1="12", x2="5", y2="12")
          polyline(points="12 19 5 12 12 5")
        span Back to Tasks

    article.task-detail-card(class=`${task.isCompleted ? 'completed' : ''} priority-${task.priority}`)
      .detail-header
        .detail-title-group
          +priority-badge(task.priority)

          if task.isCompleted
            span.status-badge.status-completed
              svg(width="14", height="14", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                polyline(points="20 6 9 17 4 12")
              span Completed
          else
            span.status-badge.status-pending
              svg(width="14", height="14", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                circle(cx="12", cy="12", r="10")
                polyline(points="12 6 12 12 16 14")
              span Pending

        h1.detail-title(dir="auto") #{task.title}

        .detail-meta
          span.meta-item
            svg.meta-icon(width="16", height="16", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
              rect(x="3", y="4", width="18", height="18", rx="2", ry="2")
              line(x1="16", y1="2", x2="16", y2="6")
              line(x1="8", y1="2", x2="8", y2="6")
              line(x1="3", y1="10", x2="21", y2="10")
            time(datetime=task.createdAt) Created #{task.createdDate} at #{task.createdTime}

      hr.divider

      .detail-body
        h2.section-label Notes

        if task.note
          .detail-note
            p(dir="auto") #{task.note}
        else
          .no-note
            svg(width="20", height="20", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
              path(d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z")
              polyline(points="14 2 14 8 20 8")
            span No description provided for this task.

      .detail-footer
        .action-buttons
          form(action=`/tasks/${task.id}/toggle`, method="POST")
            button.btn-action(
              type="submit"
              class=task.isCompleted ? "btn-undo" : "btn-toggle"
              aria-label=task.isCompleted ? "Mark task as pending" : "Mark task as completed"
            )
              if task.isCompleted
                svg(width="14", height="14", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                  polyline(points="1 4 1 10 7 10")
                  path(d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10")
                span Undo
              else
                svg(width="14", height="14", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                  polyline(points="20 6 9 17 4 12")
                span Done

          a.btn-action.btn-edit(href=`/tasks/${task.id}/edit`, aria-label="Edit task")
            svg(width="14", height="14", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
              path(d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7")
              path(d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z")
            span Edit

          button.btn-action.btn-delete.js-trigger-delete(
            type="button"
            data-task-id=task.id
            aria-label="Delete task"
          )
            svg(width="14", height="14", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
              polyline(points="3 6 5 6 21 6")
              path(d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6")
              path(d="M10 11v6")
              path(d="M14 11v6")
            span Delete