extends layouts/main-layout.pug

block head-tags
  link(rel="stylesheet", href="/css/500.css")

block content
  .error-container
    .error-card
      .error-code 500
      .error-badge Internal Server Error
      h1 Oops! Something Went Wrong
      p We are experiencing an internal server issue. Please try refreshing the page or check back later.
      
      .error-actions
        a.btn-primary(href="/") &larr; Back to Dashboard
        a.btn-secondary(href="javascript:location.reload()") &#x21bb; Refresh Page
