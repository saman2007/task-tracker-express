extends layouts/main-layout.pug

block head-tags
  link(rel="stylesheet", href="/css/auth.css")
  script(type="importmap").
    {
      "imports": {
        "zod": "/vendor/zod/index.js"
      }
    }
  script(type="module", src="/js/auth-validation.js")

block content
  .auth-container
    .auth-card
      .auth-header
        .auth-icon
          svg(width="26", height="26", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
            rect(x="3", y="11", width="18", height="11", rx="2", ry="2")
            path(d="M7 11V7a5 5 0 0 1 10 0v4")
        h1 Set New Password
        p Enter a strong new password for your account.

      if errors && errors.length > 0
        .auth-flash-banner(role="alert")
          svg.flash-icon(width="18", height="18", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
            circle(cx="12", cy="12", r="10")
            line(x1="12", y1="8", x2="12", y2="12")
            line(x1="12", y1="16", x2="12.01", y2="16")
          span.flash-message #{Array.isArray(errors) ? errors[0] : errors}

      form.auth-form(action=token ? `/reset-password/${token}` : "", method="POST", novalidate=true, data-schema="set-new-password")
        if token
          input(type="hidden", name="token", value=token)

        .form-group
          label(for="password") New Password
          .form-input-wrap
            svg.form-input-icon(width="18", height="18", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
              rect(x="3", y="11", width="18", height="11", rx="2", ry="2")
              path(d="M7 11V7a5 5 0 0 1 10 0v4")
            input#password.form-control(
              type="password", 
              name="password", 
              required=true, 
              placeholder="••••••••", 
              autocomplete="new-password"
            )
          p.password-requirements
            strong Tip: 
            | Password must be at least 8 characters long and contain both letters and numbers.

        .form-group
          label(for="confirmPassword") Confirm New Password
          .form-input-wrap
            svg.form-input-icon(width="18", height="18", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
              rect(x="3", y="11", width="18", height="11", rx="2", ry="2")
              path(d="M7 11V7a5 5 0 0 1 10 0v4")
              circle(cx="12", cy="16", r="1")
            input#confirmPassword.form-control(
              type="password", 
              name="confirmPassword", 
              required=true, 
              placeholder="••••••••", 
              autocomplete="new-password"
            )

        button.btn-primary.btn-auth-submit(type="submit")
          span Update Password
          span.btn-arrow →

      .auth-footer
        p Back to 
          a.auth-link(href="/signin") Sign in here
