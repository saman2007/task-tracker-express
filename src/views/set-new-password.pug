extends layouts/main-layout.pug

block head-tags
  link(rel="stylesheet", href="/css/auth.css")
  script(type="importmap").
    {
      "imports": {
        "zod": "/vendor/zod/index.js"
      }
    }
  script(type="module", src="/js/auth-validation.js")

block content
  .auth-container
    .auth-card
      .auth-header
        .auth-icon 🔒
        h1 Set New Password
        p Enter a strong new password for your account.

      if errors && errors.length > 0
        div.flash-container
          each error in errors
            .auth-flash-banner
              svg.flash-icon(width="16", height="16", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round")
                circle(cx="12", cy="12", r="10")
                line(x1="12", y1="8", x2="12", y2="12")
                line(x1="12", y1="16", x2="12.01", y2="16")
              span.flash-message #{error}

      form.auth-form(action=token ? `/reset-password/${token}` : "", method="POST", novalidate=true, data-schema="set-new-password")
        if token
          input(type="hidden", name="token", value=token)

        .form-group
          label(for="password") New Password
          .form-input-wrap
            span.form-input-icon 🔑
            input#password.form-control(
              type="password", 
              name="password", 
              required=true, 
              placeholder="••••••••", 
              autocomplete="new-password"
            )
          p.password-hint Min. 8 characters with at least one letter and one number.

        .form-group
          label(for="confirmPassword") Confirm New Password
          .form-input-wrap
            span.form-input-icon 🔒
            input#confirmPassword.form-control(
              type="password", 
              name="confirmPassword", 
              required=true, 
              placeholder="••••••••", 
              autocomplete="new-password"
            )

        button.btn-primary.btn-auth-submit(type="submit")
          span Update Password
          span.btn-arrow &rarr;

      .auth-footer
        p Back to 
          a.auth-link(href="/signin") Sign in here

