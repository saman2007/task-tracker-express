extends layouts/main-layout.pug

block head-tags
  link(rel="stylesheet", href="/css/landing.css")

block content
  .landing-container
    //- ============ HERO SECTION ============
    section.hero-section
      .hero-content
        .hero-badge
          span.badge-dot
          span.badge-text Minimalist Productivity
        
        h1.hero-title
          | Organize your work,
          br
          span.title-highlight focus on what matters.
        
        p.hero-subtitle
          | A lightweight, focused task manager designed to help you stay organized,
          | prioritize effectively, and complete your goals — without distractions.
        
        .hero-actions
          a.btn-primary.btn-hero-primary(href="/signup")
            span Get Started Free
            span.btn-arrow →
          
          a.btn-secondary.btn-hero-secondary(href="/signin")
            span Sign In
      
      //- Interactive Preview Card
      .hero-preview
        .preview-card
          .preview-card-header
            .preview-dots
              span.dot.dot-red
              span.dot.dot-yellow
              span.dot.dot-green
            span.preview-title Today's Focus
          
          .preview-task-list
            .preview-task-item.completed
              .task-checkbox
                svg(width="12", height="12", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="3", stroke-linecap="round", stroke-linejoin="round")
                  polyline(points="20 6 9 17 4 12")
              .task-info
                p.task-name Complete project documentation
                span.task-meta Due today • Low
              span.preview-badge.badge-low LOW
            
            .preview-task-item.active
              .task-checkbox
              .task-info
                p.task-name Refactor database seeders
                span.task-meta Tomorrow • High
              span.preview-badge.badge-high HIGH
            
            .preview-task-item
              .task-checkbox
              .task-info
                p.task-name Design responsive landing page
                span.task-meta In 2 days • Medium
              span.preview-badge.badge-medium MEDIUM

    //- ============ FEATURES SECTION ============
    section.features-section
      .section-header
        h2 Built for simplicity and speed
        p Everything you need to manage your personal workload, nothing you don't.
      
      .features-grid
        .feature-card
          .feature-icon-wrapper
            span.feature-icon
              svg(width="24", height="24", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round")
                circle(cx="12", cy="12", r="10")
                circle(cx="12", cy="12", r="6")
                circle(cx="12", cy="12", r="2")
          h3.feature-title Priority Categorization
          p.feature-description
            | Tag tasks as High, Medium, or Low to instantly identify what
            | demands your immediate attention.

        .feature-card
          .feature-icon-wrapper
            span.feature-icon
              svg(width="24", height="24", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round")
                circle(cx="12", cy="12", r="10")
                polyline(points="12 6 12 12 16 14")
          h3.feature-title Deadline Tracking
          p.feature-description
            | Keep track of upcoming due dates with clear indicators, and
            | never let a critical task slip through the cracks.

        .feature-card
          .feature-icon-wrapper
            span.feature-icon
              svg(width="24", height="24", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round")
                line(x1="18", y1="20", x2="18", y2="10")
                line(x1="12", y1="20", x2="12", y2="4")
                line(x1="6", y1="20", x2="6", y2="14")
          h3.feature-title Clear Overview
          p.feature-description
            | Instant statistics for total, completed, and pending tasks so
            | you can visualize your progress at a glance.

    //- ============ STEPS SECTION ============
    section.steps-section
      .section-header
        h2 How it works
        p Start tracking your tasks in three simple steps.
      
      .steps-grid
        .step-card
          span.step-number 01
          h3.step-title Create your account
          p.step-description
            | Sign up in seconds with just your name, email, and password.
        
        .step-card
          span.step-number 02
          h3.step-title Add your tasks
          p.step-description
            | Set title, notes, and priority level in a clean interface.
        
        .step-card
          span.step-number 03
          h3.step-title Accomplish goals
          p.step-description
            | Mark tasks as completed, edit anytime, and stay ahead of schedule.

    //- ============ CTA SECTION ============
    section.cta-section
      .cta-card
        .cta-badge
          span Ready when you are
        h2 Ready to boost your productivity?
        p Join today and take control of your daily workflow.
        
        .cta-actions
          a.btn-primary.btn-cta(href="/signup")
            span Create Free Account
            span.btn-arrow →
          
          a.btn-secondary.btn-cta-secondary(href="/signin")
            span Sign In