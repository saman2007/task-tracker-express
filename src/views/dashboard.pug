extends layouts/main-layout.pug

block head-tags
  link(rel="stylesheet", href="/css/dashboard.css")
  link(rel="stylesheet", href="/css/tasks.css")

block content
  .page-header
    h1 Welcome Back! 👋
    p Here is an overview of your current activities and progress.

  .stats-grid
    .stat-card
      span.stat-title Total Tasks
      span.stat-number #{totalTasks || 0}
      
    .stat-card.success
      span.stat-title Completed
      span.stat-number(style="color: var(--priority-low);") #{completedCount || 0}
      
    .stat-card.warning
      span.stat-title Pending
      span.stat-number(style="color: var(--priority-high);") #{pendingCount || 0}

  .recent-section-header
    h2 Recent Tasks
    a.view-all-link(href="/tasks") View All Tasks &rarr;

  if recentTasks && recentTasks.length > 0
    .tasks-grid
      each task in recentTasks
        .task-card(class=`${task.isCompleted ? 'completed' : ''} priority-${task.priority}`)
          .task-card-header
            .title-wrapper
              a.task-card-link(href=`/tasks/${task.id}`)
                h3.task-title #{task.title}
            span.badge(class=`badge-${task.priority}`)
              if task.priority === 2
                | 🔥 High
              else if task.priority === 1
                | ⚡ Medium
              else if task.priority === 0
                | 🌱 Low

          if task.note
            p.task-note #{task.note}

          .task-card-footer
            .task-date
              span.date-icon 🗓️
              span #{task.createdAt ? task.date + ' • ' + task.time : ''}
            
            .task-actions
              form(action=`/tasks/${task.id}/toggle`, method="POST")
                button.btn-action(type="submit", class=task.isCompleted ? "btn-undo" : "btn-toggle", title=task.isCompleted ? "Mark as Pending" : "Mark as Completed")
                  if task.isCompleted
                    span ↺ UnDone
                  else
                    span ✓ Done

              form(action=`/tasks/${task.id}/delete`, method="POST")
                button.btn-action.btn-delete(type="submit", title="Delete Task")
                  span ✕
  else
    .empty-state
      p No tasks found!
      a.btn-primary(href="/tasks/add", style="display: inline-block; margin-top: 1.5rem;") Create Your First Task