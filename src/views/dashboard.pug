extends layouts/main-layout.pug
include mixins/task-card.pug
include mixins/icons.pug

block head-tags
  link(rel="stylesheet", href="/css/dashboard.css")
  link(rel="stylesheet", href="/css/tasks.css")

block content
  .page-header.dashboard-header
    .header-content
      h1
        span#greetingText Welcome Back
      p Here's an overview of your current activities and progress.

    a.btn-primary(href="/tasks/add")
      span + Add Task
      span.btn-arrow →

  - const total = totalTasks || 0;
  - const done = completedCount || 0;
  - const percent = total > 0 ? Math.round((done / total) * 100) : 0;

  .stats-grid
    .stat-card
      .stat-icon-wrapper
        span.stat-icon
          +icon('check-square', 22)
      span.stat-number #{total}
      span.stat-title Total Tasks

    .stat-card.success
      .stat-icon-wrapper
        span.stat-icon
          +icon('check', 22)
      span.stat-number #{done}
      span.stat-title Completed

    .stat-card.warning
      .stat-icon-wrapper
        span.stat-icon
          +icon('clock', 22)
      span.stat-number #{pendingCount || 0}
      span.stat-title Pending

  .progress-card
    .progress-head
      span.progress-label Completion Rate
      span.progress-value #{percent}%
    .progress-track
      if percent > 0
        .progress-fill(style=`width: ${percent}%`)

  .recent-section-header
    h2 Recent Tasks
    a.view-all-link(href="/tasks")
      span View All Tasks
      span.view-arrow →

  if recentTasks && recentTasks.length > 0
    .tasks-grid
      each task in recentTasks
        +taskCard(task)
  else
    .empty-state
      .empty-state-icon
        +icon('tasks', 48)
      h2 No tasks yet
      p Start your journey by creating your first task.
      a.btn-primary(href="/tasks/add")
        span + Create Your First Task
        span.btn-arrow →