extends layouts/main-layout.pug

block head-tags
  link(rel="stylesheet", href="/css/auth.css")
  script(type="importmap").
    {
      "imports": {
        "zod": "/vendor/zod/index.js"
      }
    }
  script(type="module", src="/js/auth-validation.js")

block content
  .auth-container
    .auth-card
      .auth-header
        .auth-icon 🚀
        h1 Create an Account
        p Join TaskTracker today to organize your tasks and boost productivity.

      if error && error.length > 0
        .auth-flash-banner
          svg.flash-icon(width="16", height="16", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round")
            circle(cx="12", cy="12", r="10")
            line(x1="12", y1="8", x2="12", y2="12")
            line(x1="12", y1="16", x2="12.01", y2="16")
          span.flash-message #{Array.isArray(error) ? error[0] : error}

      form.auth-form(action="/signup", method="POST", novalidate=true)
        .form-group
          label(for="fullname") Full Name
          .form-input-wrap
            span.form-input-icon 👤
            input#name.form-control(
              type="text", 
              name="fullname", 
              required=true, 
              placeholder="Alex Johnson", 
              autocomplete="name"
            )

        .form-group
          label(for="email") Email Address
          .form-input-wrap
            span.form-input-icon ✉️
            input#email.form-control(
              type="email", 
              name="email", 
              required=true, 
              placeholder="alex@example.com", 
              autocomplete="email"
            )

        .form-row
          .form-group
            label(for="password") Password
            .form-input-wrap
              span.form-input-icon 🔑
              input#password.form-control(
                type="password", 
                name="password", 
                required=true, 
                placeholder="••••••••", 
                autocomplete="new-password"
              )
          .form-group
            label(for="confirmPassword") Confirm Password
            .form-input-wrap
              span.form-input-icon 🔒
              input#confirmPassword.form-control(
                type="password", 
                name="confirmPassword", 
                required=true, 
                placeholder="••••••••", 
                autocomplete="new-password"
              )

        .auth-options
          label.checkbox-label
            input(type="checkbox", name="agreeTerms", required="true", value="true")
            span I agree to the 
              a.auth-link(href="#") Terms
              |  &amp; 
              a.auth-link(href="#") Privacy Policy

        button.btn-primary.btn-auth-submit(type="submit")
          span Create Account
          span.btn-arrow &rarr;

      .auth-footer
        p Already have an account? 
          a.auth-link(href="/signin") Sign in here
