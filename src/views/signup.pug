extends layouts/main-layout.pug

block head-tags
  link(rel="stylesheet", href="/css/auth.css")
  script(type="importmap").
    {
      "imports": {
        "zod": "/vendor/zod/index.js"
      }
    }
  script(type="module", src="/js/auth-validation.js")

block content
  .auth-container
    .auth-card
      .auth-header
        .auth-icon
          svg(width="26", height="26", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
            line(x1="22", y1="2", x2="11", y2="13")
            polygon(points="22 2 15 22 11 13 2 9 22 2")

        h1 Create an Account
        p Join TaskTracker to organize your tasks and boost productivity.

      if error && error.length > 0
        .auth-flash-banner(role="alert")
          svg.flash-icon(width="18", height="18", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
            circle(cx="12", cy="12", r="10")
            line(x1="12", y1="8", x2="12", y2="12")
            line(x1="12", y1="16", x2="12.01", y2="16")
          span.flash-message #{Array.isArray(error) ? error[0] : error}

      form.auth-form(action="/signup", method="POST", novalidate=true)
        .form-group
          label(for="fullname") Full Name
          .form-input-wrap
            svg.form-input-icon(width="18", height="18", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
              path(d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2")
              circle(cx="12", cy="7", r="4")
            input#fullname.form-control(
              type="text"
              name="fullname"
              required=true
              placeholder="Alex Johnson"
              autocomplete="name"
              dir="auto"
            )

        .form-group
          label(for="email") Email Address
          .form-input-wrap
            svg.form-input-icon(width="18", height="18", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
              path(d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z")
              polyline(points="22,6 12,13 2,6")
            input#email.form-control(
              type="email"
              name="email"
              required=true
              placeholder="alex@example.com"
              autocomplete="email"
            )

        .form-row
          .form-group
            label(for="password") Password
            .form-input-wrap
              svg.form-input-icon(width="18", height="18", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                rect(x="3", y="11", width="18", height="11", rx="2", ry="2")
                path(d="M7 11V7a5 5 0 0 1 10 0v4")
              input#password.form-control(
                type="password"
                name="password"
                required=true
                placeholder="••••••••"
                autocomplete="new-password"
              )

          .form-group
            label(for="confirmPassword") Confirm Password
            .form-input-wrap
              svg.form-input-icon(width="18", height="18", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                rect(x="3", y="11", width="18", height="11", rx="2", ry="2")
                path(d="M7 11V7a5 5 0 0 1 10 0v4")
                circle(cx="12", cy="16", r="1")
              input#confirmPassword.form-control(
                type="password"
                name="confirmPassword"
                required=true
                placeholder="••••••••"
                autocomplete="new-password"
              )

        .auth-options
          label.checkbox-label
            input(type="checkbox", name="agreeTerms", required=true)
            span
              | I agree to the
              |
              a.auth-link(href="#") Terms
              |  &
              |
              a.auth-link(href="#") Privacy Policy

        button.btn-primary.btn-auth-submit(type="submit")
          span Create Account
          span.btn-arrow →

      .auth-footer
        p
          | Already have an account?
          |
          a.auth-link(href="/signin") Sign in here