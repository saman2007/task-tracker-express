extends layouts/main-layout.pug

block head-tags
  link(rel="stylesheet", href="/css/auth.css")
  script(type="importmap").
    {
      "imports": {
        "zod": "/vendor/zod/index.js"
      }
    }
  script(type="module", src="/js/auth-validation.js")  

block content
  .auth-container
    .auth-card
      .auth-header
        .auth-icon 🔐
        h1 Welcome Back
        p Sign in to your account to continue managing your tasks.

      if errors && errors.length > 0
        div.flash-container
          each error in errors
            .auth-flash-banner
              svg.flash-icon(width="16", height="16", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round")
                circle(cx="12", cy="12", r="10")
                line(x1="12", y1="8", x2="12", y2="12")
                line(x1="12", y1="16", x2="12.01", y2="16")
              span.flash-message #{error}

      form.auth-form(action="/signin", method="POST", novalidate=true)
        .form-group
          label(for="email") Email Address
          .form-input-wrap
            span.form-input-icon ✉️
            input#email.form-control(
              type="email", 
              name="email", 
              required=true, 
              placeholder="alex@example.com", 
              autocomplete="email",
              value=oldInputs ? oldInputs.email : ""
            )

        .form-group
          label(for="password") Password
          .form-input-wrap
            span.form-input-icon 🔑
            input#password.form-control(
              type="password", 
              name="password", 
              required=true, 
              placeholder="••••••••", 
              autocomplete="current-password"
              value=oldInputs ? oldInputs.password : ""
            )

        .auth-options
          label.checkbox-label
            input(type="checkbox", name="rememberMe", value="true")
            span Remember me
          a.auth-link(href="#") Forgot password?

        button.btn-primary.btn-auth-submit(type="submit")
          span Sign In
          span.btn-arrow &rarr;

      .auth-footer
        p Don't have an account? 
          a.auth-link(href="/signup") Sign up here
