extends layouts/main-layout.pug

block head-tags
  link(rel="stylesheet", href="/css/auth.css")
  script(type="importmap").
    {
      "imports": {
        "zod": "/vendor/zod/index.js"
      }
    }
  script(type="module", src="/js/auth-validation.js")

block content
  .auth-container
    .auth-card
      .auth-header
        .auth-icon 🔑
        h1 Reset Password
        p Enter your email address and we'll send you instructions to reset your password.

      if errors && errors.length > 0
        div.flash-container
          each error in errors
            .auth-flash-banner
              svg.flash-icon(width="16", height="16", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round")
                circle(cx="12", cy="12", r="10")
                line(x1="12", y1="8", x2="12", y2="12")
                line(x1="12", y1="16", x2="12.01", y2="16")
              span.flash-message #{error}

      if success && success.length > 0
        div.flash-container
          each msg in success
            .auth-flash-banner.success
              svg.flash-icon(width="16", height="16", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round")
                path(d="M22 11.08V12a10 10 0 1 1-5.93-9.14")
                polyline(points="22 4 12 14.01 9 11.01")
              span.flash-message #{msg}

      form.auth-form(action="/reset-password", method="POST", novalidate=true, data-schema="reset-password")
        .form-group
          label(for="email") Email Address
          .form-input-wrap
            span.form-input-icon ✉️
            input#email.form-control(
              type="email",
              name="email",
              required=true,
              placeholder="alex@example.com",
              autocomplete="email",
              value=oldInputs ? oldInputs.email : ""
            )

        button.btn-primary.btn-auth-submit(type="submit")
          span Send Reset Link
          span.btn-arrow &rarr;

      .auth-footer
        p Remember your password? 
          a.auth-link(href="/signin") Sign in here

