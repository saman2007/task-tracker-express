extends layouts/main-layout.pug

block head-tags
  link(rel="stylesheet", href="/css/auth.css")
  script(type="importmap").
    {
      "imports": {
        "zod": "/vendor/zod/index.js"
      }
    }
  script(type="module", src="/js/auth-validation.js")

block content
  .auth-container
    .auth-card
      .auth-header
        .auth-icon
          svg(width="26", height="26", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
            path(d="M21 2l-2 2m-1.5 1.5L10 13m-2 2H4v4h4v-2l1-1m2-2l2-2m2-2l2-2")
            circle(cx="7.5", cy="16.5", r="1.5")
            circle(cx="16.5", cy="7.5", r="4.5")
        h1 Reset Password
        p Enter your email address and we'll send you instructions to reset your password.

      if errors && errors.length > 0
        .auth-flash-banner(role="alert")
          svg.flash-icon(width="18", height="18", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
            circle(cx="12", cy="12", r="10")
            line(x1="12", y1="8", x2="12", y2="12")
            line(x1="12", y1="16", x2="12.01", y2="16")
          span.flash-message #{Array.isArray(errors) ? errors[0] : errors}

      if success && success.length > 0
        .auth-flash-banner.success(role="alert")
          svg.flash-icon(width="18", height="18", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
            polyline(points="20 6 9 17 4 12")
          span.flash-message #{Array.isArray(success) ? success[0] : success}

      form.auth-form(action="/reset-password", method="POST", novalidate=true, data-schema="reset-password")
        .form-group
          label(for="email") Email Address
          .form-input-wrap
            svg.form-input-icon(width="18", height="18", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
              path(d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z")
              polyline(points="22,6 12,13 2,6")
            input#email.form-control(
              type="email",
              name="email",
              required=true,
              placeholder="alex@example.com",
              autocomplete="email",
              value=oldInputs ? oldInputs.email : ""
            )

        button.btn-primary.btn-auth-submit(type="submit")
          span Send Reset Link
          span.btn-arrow →

      .auth-footer
        p Remember your password? 
          a.auth-link(href="/signin") Sign in here
