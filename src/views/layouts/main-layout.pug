include ../mixins/delete-modal.pug

doctype html
html(lang="en", dir="ltr")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title #{pageTitle} | Task Tracker
    
    link(rel="stylesheet", href="/css/global.css")
    
    block head-tags

  body
    header.navbar
      .nav-container
        a.nav-logo(href="/")
          span ⚡ TaskTracker
        nav.nav-menu
          if isLoggedIn
            a.nav-link(href="/tasks") Tasks
            .profile-dropdown-container
              button.profile-btn#profileDropdownBtn(type="button", aria-expanded="false", aria-haspopup="true", title=currentUser && currentUser.fullname ? currentUser.fullname : "Profile")
                span.profile-avatar
                  if avatar
                    img(src=avatar, alt=currentUser && currentUser.fullname ? currentUser.fullname : "Avatar")
                  else
                    | #{currentUser && currentUser.fullname ? currentUser.fullname.trim().charAt(0).toUpperCase() : 'U'}
                svg.profile-arrow(width="12", height="12", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round")
                  polyline(points="6 9 12 15 18 9")
              .profile-dropdown-menu#profileDropdownMenu
                if currentUser
                  .profile-user-info
                    p.profile-user-name #{currentUser.fullname}
                    p.profile-user-email #{currentUser.email}
                  .profile-dropdown-divider
                a.profile-dropdown-item(href="/tasks/add")
                  span.dropdown-icon ➕
                  span Add Task
                a.profile-dropdown-item(href="/settings")
                  span.dropdown-icon ⚙️
                  span Settings
                form.profile-logout-form(action="/logout", method="POST")
                  button.profile-dropdown-item.logout-btn(type="submit")
                    span.dropdown-icon 🚪
                    span Log out
          else
            a.btn-nav-signin(href="/signin") Sign In
            a.btn-nav-signup(href="/signup") Sign Up

    main.main-wrapper
      block content

    footer(style="text-align: center; color: #94a3b8; padding: 2rem 0; margin-top: 3rem;")
      p 
        span(style="color: var(--primary); font-size: 18px;") #{"<"}
        |Created by 
        a(href="https://github.com/saman2007" style="color: var(--primary); text-decoration: none;" target="blank") samii_dev with  
        span(style="color: var(--primary); font-size: 18px;") &hearts; #{"/>"}
    
    +deleteModal()

    script(src="/js/delete-modal.js")
    script(src="/js/profile-dropdown.js")