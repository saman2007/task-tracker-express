extends layouts/main-layout.pug

block head-tags
  link(rel="stylesheet", href="/css/auth.css")

block content
  .auth-container
    .auth-card
      .auth-header
        .auth-icon
          svg(width="26", height="26", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
            path(d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z")
            polyline(points="22,6 12,13 2,6")
        h1 Verify Your Account
        p Please verify your email address to activate your account.

      if errors && errors.length > 0
        .auth-flash-banner(role="alert")
          svg.flash-icon(width="18", height="18", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
            circle(cx="12", cy="12", r="10")
            line(x1="12", y1="8", x2="12", y2="12")
            line(x1="12", y1="16", x2="12.01", y2="16")
          span.flash-message #{Array.isArray(errors) ? errors[0] : errors}

      if success && success.length > 0
        .auth-flash-banner.success(role="alert")
          svg.flash-icon(width="18", height="18", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
            polyline(points="20 6 9 17 4 12")
          span.flash-message #{Array.isArray(success) ? success[0] : success}

      if sentSuccess
        .info-callout
          p
            | We've sent a verification link to your email
            if email
              | : #[strong #{email}]
            | .
          p Please click the link in your email to complete your registration. If you don't see it, check your spam folder.

      form.auth-form(action="/account/resend-verification", method="POST")
        input(type="hidden", name="email", value=email)

        button.btn-primary.btn-auth-submit(type="submit")
          span Resend Verification Link
          span.btn-arrow →

      .auth-footer
        p Already verified or want to sign in? 
          a.auth-link(href="/signin") Back to Sign In
