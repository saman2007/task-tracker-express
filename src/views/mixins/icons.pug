//- =========================================================
//- Central SVG Icon System
//- Usage: +icon('name', size)
//- =========================================================

mixin icon(name, size)
  - size = size || 18
  svg.icon(class=`icon-${name}`, width=size, height=size, viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
    case name
      when 'bolt'
        polygon(points="13 2 3 14 12 14 11 22 21 10 12 10 13 2", fill="currentColor", stroke-width="1.5")
      when 'dashboard'
        rect(x="3", y="3", width="7", height="9", rx="1")
        rect(x="14", y="3", width="7", height="5", rx="1")
        rect(x="14", y="12", width="7", height="9", rx="1")
        rect(x="3", y="16", width="7", height="5", rx="1")
      when 'tasks'
        path(d="m3 17 2 2 4-4")
        path(d="m3 7 2 2 4-4")
        path(d="M13 6h8")
        path(d="M13 12h8")
        path(d="M13 18h8")
      when 'sun'
        circle(cx="12", cy="12", r="4")
        path(d="M12 2v2")
        path(d="M12 20v2")
        path(d="m4.93 4.93 1.41 1.41")
        path(d="m17.66 17.66 1.41 1.41")
        path(d="M2 12h2")
        path(d="M20 12h2")
        path(d="m6.34 17.66-1.41 1.41")
        path(d="m19.07 4.93-1.41 1.41")
      when 'moon'
        path(d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z")
      when 'plus'
        path(d="M5 12h14")
        path(d="M12 5v14")
      when 'settings'
        circle(cx="12", cy="12", r="3")
        path(d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z")
      when 'logout'
        path(d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4")
        polyline(points="16 17 21 12 16 7")
        line(x1="21", y1="12", x2="9", y2="12")
      when 'flame'
        path(d="M8.5 14.5A2.5 2 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z")
      when 'zap'
        polygon(points="13 2 3 14 12 14 11 22 21 10 12 10 13 2")
      when 'leaf'
        path(d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z")
        path(d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12")
      when 'layers'
        polygon(points="12 2 2 7 12 12 22 7 12 2")
        polyline(points="2 17 12 22 22 17")
        polyline(points="2 12 12 17 22 12")
      when 'check'
        polyline(points="20 6 9 17 4 12")
      when 'check-square'
        path(d="m9 11 3 3L22 4")
        path(d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11")
      when 'clock'
        circle(cx="12", cy="12", r="10")
        polyline(points="12 6 12 12 16 14")
      when 'github'
        path(d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4")
        path(d="M9 18c-4.51 2-5-2-7-2")
      when 'arrow-up'
        line(x1="12", y1="19", x2="12", y2="5")
        polyline(points="5 12 12 5 19 12")
      when 'heart'
        path(d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z", fill="currentColor", stroke-width="1.5")
      when 'alert-triangle'
        path(d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z")
        line(x1="12", y1="9", x2="12", y2="13")
        line(x1="12", y1="17", x2="12.01", y2="17")
      when 'trash'
        polyline(points="3 6 5 6 21 6")
        path(d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6")
        path(d="M10 11v6")
        path(d="M14 11v6")
      when 'target'
        circle(cx="12", cy="12", r="10")
        circle(cx="12", cy="12", r="6")
        circle(cx="12", cy="12", r="2")
      when 'bell'
        path(d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9")
        path(d="M10.3 21a1.94 1.94 0 0 0 3.4 0")
      when 'play'
        polygon(points="5 3 19 12 5 21 5 3", fill="currentColor")
      when 'pause'
        rect(x="6", y="4", width="4", height="16", fill="currentColor")
        rect(x="14", y="4", width="4", height="16", fill="currentColor")