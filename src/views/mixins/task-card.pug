include priority-badge.pug

mixin taskCard(task)
  article.task-card(class=`${task.isCompleted ? 'completed' : ''} priority-${task.priority}`)
    .task-card-header
      .title-wrapper
        a.task-card-link(href=`/tasks/${task.id}`, aria-label=`View task: ${task.title}`)
          h3.task-title(dir="auto") #{task.title}

      +priority-badge(task.priority)

    if task.note
      p.task-note(dir="auto") #{task.note}

    .task-card-footer
      .task-date
        span.date-icon
          svg(width="14", height="14", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
            rect(x="3", y="4", width="18", height="18", rx="2", ry="2")
            line(x1="16", y1="2", x2="16", y2="6")
            line(x1="8", y1="2", x2="8", y2="6")
            line(x1="3", y1="10", x2="21", y2="10")

        time(datetime=task.createdAt) #{task.createdAt ? task.createdDate + ' • ' + task.createdTime : ''}

      .task-actions
        form(action=`/tasks/${task.id}/toggle`, method="POST")
          button.btn-action(
            type="submit"
            class=task.isCompleted ? "btn-undo" : "btn-toggle"
            title=task.isCompleted ? "Mark as Pending" : "Mark as Completed"
            aria-label=task.isCompleted ? "Mark task as pending" : "Mark task as completed"
          )
            if task.isCompleted
              span.action-icon
                svg(width="14", height="14", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                  polyline(points="1 4 1 10 7 10")
                  path(d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10")
              span UnDone
            else
              span.action-icon
                svg(width="14", height="14", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
                  polyline(points="20 6 9 17 4 12")
              span Done

        button.btn-action.btn-delete.js-trigger-delete(
          type="button"
          data-task-id=task.id
          title="Delete Task"
          aria-label=`Delete task: ${task.title}`
        )
          svg(width="14", height="14", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2.5", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
            polyline(points="3 6 5 6 21 6")
            path(d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6")
            path(d="M10 11v6")
            path(d="M14 11v6")