include icons.pug

mixin deleteModal()
  .modal-overlay#deleteModalOverlay(aria-hidden="true", role="dialog", aria-labelledby="deleteModalTitle", aria-describedby="deleteModalDesc")
    .modal-card
      .modal-header
        .modal-icon-wrapper
          +icon('alert-triangle', 28)
        h3#deleteModalTitle Delete Task?

      p#deleteModalDesc.modal-description
        | This action cannot be undone. The task will be permanently removed from your list.

      .modal-actions
        form#deleteTaskForm(method="POST")
          button.btn-danger(type="submit")
            span Yes, Delete
            +icon('trash', 16)

        button.btn-secondary#cancelDeleteBtn(type="button")
          span Cancel